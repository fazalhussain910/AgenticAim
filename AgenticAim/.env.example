# AgenticAim — Environment Variables Template
# =============================================
# Copy this file to `.env` and fill in your actual values.
# The .env file is automatically loaded by config.py via python-dotenv.
# ⚠️  NEVER commit your real .env file to source control.

# AMD Token Factory API
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_API_KEY= "_________________________________"

# Model Selection (verified live via AMD /v1/models endpoint — update if AMD rotates)
AMD_TEXT_MODEL=DeepSeek-V4.1-Flash
AMD_VISION_MODEL=DeepSeek-V4-Flash-Vision-Exp
AMD_EMBED_MODEL=nomic-embed-text

# Database path (relative to project root)
DB_PATH=agenticaim.db

# FastAPI server
API_HOST=0.0.0.0
API_PORT=8000

# ── Qdrant Vector Database (Hybrid RAG + Adaptive Personal Memory) ──────────
# Option A: Qdrant Cloud (recommended — free tier available at cloud.qdrant.io)
# QDRANT_URL=https://YOUR_CLUSTER_ID.europe-west3-0.gcp.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# Option B: Local Qdrant (run via Docker: docker run -p 6333:6333 qdrant/qdrant)
# Leave QDRANT_URL blank to use host:port below.
QDRANT_HOST=localhost
QDRANT_PORT=6333
